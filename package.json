{
    "name": "portfolio",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "engines": {
        "node": ">=22.22"
    },
    "scripts": {
        "dev": "vite",
        "build": "tsc -b && vite build",
        "check:budget": "node scripts/check-performance-budget.ts",
